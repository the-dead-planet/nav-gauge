{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@ui": [
        "../ui/src"
      ]
    },
    "types": [
      "react",
      "react-native",
      "jest"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "*/test/**/*",
    "__tests__/**/*",
    "*/types/**/*",
    "../types/**/*",
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}