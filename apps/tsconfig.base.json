{
    "compilerOptions": {
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "rootDir": "./",
        "lib": [
            "ESNext"
        ],
        "typeRoots": [
            "types",
            "node_modules/@types"
        ]
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}