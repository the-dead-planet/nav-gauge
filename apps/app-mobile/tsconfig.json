{
    "extends": "../tsconfig.mobile.json",
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "paths": {
            "@apparatus": [
                "../apparatus/common/src"
            ],
            "@mobile-apparatus": [
                "../apparatus/mobile/src"
            ],
            "@tinker-chest": [
                "../tinker-chest/src"
            ],
            "@ui": [
                "../ui/common/src"
            ],
            "@mobile-ui": [
                "../ui/mobile/src"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "__tests__/**/*",
        "../types/**/*"
, "src/machine-ward.tsx"    ]
}