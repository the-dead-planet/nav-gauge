{
    "name": "@the-dead-planet/nav-gauge",
    "version": "1.0.0",
    "description": "Navigation gauge and route story generator.",
    "homepage": "https://gauge.spookydoodle.com",
    "private": true,
    "license": "AGPL-3.0",
    "author": "spookydoodle",
    "funding": "https://ko-fi.com/spookydoodle",
    "repository": "https://github.com/the-dead-planet/nav-gauge",
    "bugs": {
        "url": "https://github.com/the-dead-planet/nav-gauge/issues"
    },
    "scripts": {
        "dev:web": "yarn workspace @the-dead-planet/nav-gauge-app-web dev",
        "dev:mobile": "yarn workspace @the-dead-planet/nav-gauge-app-mobile android",
        "start:web": "yarn workspace @the-dead-planet/nav-gauge-app-web start",
        "start:mobile": "yarn workspace @the-dead-planet/nav-gauge-app-mobile start",
        "start:mobile:r": "yarn workspace @the-dead-planet/nav-gauge-app-mobile start:r",
        "build:web": "yarn workspace @the-dead-planet/nav-gauge-app-web build",
        
        "test:all": "concurrently \"yarn test:common\" \"yarn test:web\" \"yarn test:mobile\"",
        
        "test:common": "yarn test:packages && yarn test:gears-common && yarn test:ui-common",
        "test:mobile": "yarn test:app-mobile && yarn test:gears-mobile && yarn test:ui-mobile",
        "test:web": "yarn test:app-web && yarn test:gears-web && yarn test:ui-web",
        
        "test:app-web": "yarn workspace @the-dead-planet/nav-gauge-app-web test",
        "test:app-mobile": "yarn workspace @the-dead-planet/nav-gauge-app-mobile test",

        "test:gears": "yarn test:gears-common && yarn test:gears-mobile && yarn test:gears-web",
        "test:gears-common": "yarn workspace @the-dead-planet/nav-gauge-gears-route-story-common test",
        "test:gears-mobile": "yarn workspace @the-dead-planet/nav-gauge-gears-route-story-mobile test",
        "test:gears-web": "yarn workspace @the-dead-planet/nav-gauge-gears-route-story-web test",

        "test:packages": "yarn test:apparatus && yarn test:tinker-chest",
        "test:apparatus": "yarn workspace @the-dead-planet/nav-gauge-apparatus test",
        "test:tinker-chest": "yarn workspace @the-dead-planet/nav-gauge-tinker-chest test",

        "test:ui": "yarn test:ui-common && yarn test:ui-mobile && yarn test:ui-web",
        "test:ui-common": "yarn workspace @the-dead-planet/nav-gauge-ui-common test",
        "test:ui-mobile": "yarn workspace @the-dead-planet/nav-gauge-ui-mobile test",
        "test:ui-web": "yarn workspace @the-dead-planet/nav-gauge-ui-web test",

        "test:e2e:web": "yarn workspace @the-dead-planet/nav-gauge-app-web test:e2e:prod",
        "test:e2e:mobile": "yarn workspace @the-dead-planet/nav-gauge-app-mobile test:e2e:prod"
    },
    "dependencies": {
        "@maplibre/maplibre-gl-style-spec": "^24.8.1",
        "@turf/along": "^7.3.5",
        "@turf/bbox": "^7.3.5",
        "@turf/bearing": "^7.3.5",
        "@turf/distance": "^7.3.5",
        "@turf/helpers": "^7.3.5",
        "@turf/length": "^7.3.5",
        "luxon": "^3.7.2",
        "react": "19.2.5",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/eslint": "^9.6.1",
        "@types/luxon": "^3.7.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@typescript-eslint/eslint-plugin": "^8.59.0",
        "@typescript-eslint/parser": "^8.59.0",
        "chai": "^6.2.2",
        "concurrently": "^9.2.1",
        "eslint": "^10.2.1",
        "mocha": "^11.7.5",
        "path": "^0.12.7",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    },
    "resolutions": {
        "react": "19.2.5"
    },
    "workspaces": {
        "packages": [
            "app-web",
            "app-mobile",
            "ui/*",
            "packages/*",
            "gears/*/common",
            "gears/*/mobile",
            "gears/*/web"
        ]
    }
}
