{
    "name": "@the-dead-planet/nav-gauge",
    "version": "1.0.0",
    "description": "Navigation gauge and route story generator.",
    "homepage": "https://gauge.spookydoodle.com",
    "private": true,
    "license": "AGPL-3.0",
    "author": "spookydoodle",
    "funding": "https://ko-fi.com/spookydoodle",
    "repository": "https://github.com/the-dead-planet/nav-gauge",
    "bugs": {
        "url": "https://github.com/the-dead-planet/nav-gauge/issues"
    },
    "scripts": {
        "dev:web": "yarn workspace @the-dead-planet/nav-gauge-web-app dev",
        "dev:mobile": "yarn workspace @the-dead-planet/nav-gauge-mobile-app android",
        "start:web": "yarn workspace @the-dead-planet/nav-gauge-web-app start",
        "start:mobile": "yarn workspace @the-dead-planet/nav-gauge-mobile-app start",
        "start:mobile:r": "yarn workspace @the-dead-planet/nav-gauge-mobile-app start:r",
        "build:web": "yarn workspace @the-dead-planet/nav-gauge-web-app build",
        "test:ui": "yarn workspace @the-dead-planet/nav-gauge-ui test",
        "test:packages": "yarn test:apparatus && yarn test:tinker-chest",
        "test:apparatus": "yarn workspace @the-dead-planet/nav-gauge-apparatus test",
        "test:tinker-chest": "yarn workspace @the-dead-planet/nav-gauge-tinker-chest test",
        "test:web": "yarn test:web-app && yarn test:web-gears && yarn test:web-ui",
        "test:web-app": "yarn workspace @the-dead-planet/nav-gauge-web-app test",
        "test:web-gears": "yarn workspace @the-dead-planet/nav-gauge-web-gears-route-story test",
        "test:web-ui": "yarn workspace @the-dead-planet/nav-gauge-web-ui test",
        "test:mobile": "yarn test:mobile-app && yarn test:mobile-ui",
        "test:mobile-app": "yarn workspace @the-dead-planet/nav-gauge-mobile-app test",
        "test:mobile-ui": "yarn workspace @the-dead-planet/nav-gauge-mobile-ui test",
        "test:all": "concurrently \"yarn test:ui\" \"yarn test:packages\" \"yarn test:web\" \"yarn test:mobile\"",
        "test:all:web": "concurrently \"yarn test:ui\" \"yarn test:packages\" \"yarn test:web\"",
        "test:all:mobile": "concurrently \"yarn test:ui\" \"yarn test:packages\" \"yarn test:mobile\"",
        "test:e2e:web": "yarn workspace @the-dead-planet/nav-gauge-web-app test:e2e:prod",
        "test:e2e:mobile": "yarn workspace @the-dead-planet/nav-gauge-mobile-app test:e2e:prod"
    },
    "dependencies": {
        "@maplibre/maplibre-gl-style-spec": "^24.4.1",
        "@turf/along": "^7.3.2",
        "@turf/bbox": "^7.3.2",
        "@turf/bearing": "^7.3.2",
        "@turf/distance": "^7.3.2",
        "@turf/helpers": "^7.3.2",
        "@turf/length": "^7.3.2",
        "luxon": "^3.7.2",
        "react": "^19.2.3",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/eslint": "^9.6.1",
        "@types/luxon": "^3.7.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.0.8",
        "@types/react": "^19.2.9",
        "@typescript-eslint/eslint-plugin": "^8.53.0",
        "@typescript-eslint/parser": "^8.53.0",
        "chai": "^6.2.2",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.2",
        "mocha": "^11.7.5",
        "path": "^0.12.7",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "resolutions": {
        "react": "^19.2.3"
    },
    "workspaces": {
        "packages": [
            "web-app",
            "mobile",
            "ui/*",
            "packages/*",
            "gears/*/common",
            "gears/*/mobile",
            "gears/*/web"
        ]
    }
}
