{
    "name": "@the-dead-planet/nav-gauge-ui-web",
    "version": "1.0.0",
    "private": true,
    "main": "src/index.ts",
    "scripts": {
        "build": "tsc -b",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "preview": "rsbuild preview --dist-path storybook-static --port 6006 --strict-port",
        "typecheck:cypress": "tsc --noEmit -p cypress/tsconfig.json",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings -1",
        "test": "mocha",
        "test:e2e": "yarn typecheck:cypress && cypress run"
    },
    "dependencies": {
        "@the-dead-planet/nav-gauge-tinker-chest": "*",
        "@the-dead-planet/nav-gauge-ui-common": "*",
        "classnames": "^2.5.1",
        "react-svg": "^19.2.3"
    },
    "devDependencies": {
        "@rsbuild/core": "^2.2.14",
        "@rsbuild/plugin-react": "^2.1.1",
        "@storybook/addon-docs": "10.6.3",
        "@types/react-dom": "19.3.0",
        "css-loader": "^7.1.5",
        "cypress": "^16.2.0",
        "maplibre-gl": "6.15.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "storybook": "^10.6.3",
        "storybook-addon-code-editor": "^6.2.0",
        "storybook-react-rsbuild": "^3.6.1"
    },
    "peerDependencies": {
        "maplibre-gl": "6.15.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "rxjs": "^7.8.2"
    }
}
